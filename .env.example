# FreshShare Environment Variables
# Copy this file to .env and fill in your actual values

# Node Environment
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb://127.0.0.1:27017/freshshare_db

# JWT Secret (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_secret_here_min_32_characters

# Legacy JWT Secret (if migrating from old tokens)
LEGACY_JWT_SECRET=

# Application URL
APP_URL=http://localhost:3002

# USDA API (optional)
USDA_API_KEY=

# Email Configuration (optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=FreshShare <noreply@freshshare.com>

# Asset Version
ASSET_VERSION=1.0.0
