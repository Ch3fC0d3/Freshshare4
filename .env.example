# FreshShare Environment Variables
# Copy this file to .env and fill in your actual values

# Node Environment
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb://127.0.0.1:27017/freshshare_db

# JWT Secret (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_secret_here_min_32_characters

# Legacy JWT Secret (if migrating from old tokens)
LEGACY_JWT_SECRET=

# Application URL
APP_URL=http://localhost:3002

# USDA API (optional)
USDA_API_KEY=

# Email Configuration (required for email verification)
# For Gmail: use smtp.gmail.com, port 587, and an app-specific password
# For custom domain: use your mail server settings (e.g., mail.yourdomain.com)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=FreshShare <noreply@freshshare.com>
# Note: Use port 465 if your provider requires SSL (secure: true is automatic for port 465)

# Asset Version
ASSET_VERSION=1.0.0
